# Host/port the Uvicorn server binds to
HOST=127.0.0.1
PORT=8000

# React dev server origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Comma-separated extra origins allowed by CORS (optional)
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:5173

# Maximum accepted selfie upload size, in megabytes
MAX_UPLOAD_SIZE_MB=10
